# Unity / Windows
# Place this file beside Assets, Packages and ProjectSettings.
# Reference: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Keep Assets (including .meta), Packages and ProjectSettings in Git.

# Unity-generated caches and local editor settings
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/.utmp/
/UIElementsSchema/

# Build output: put Windows builds in Build or Builds
/[Bb]uild/
/[Bb]uilds/
/ExportedObj/
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/

# Profiler captures and recordings
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Visual Studio / Rider local caches
/.vs/
/.idea/
/.consulo/
*.DotSettings.user
*.suo
*.user
*.userprefs

# IDE project files generated by Unity at the project root
/*.csproj
/*.unityproj
/*.sln
/*.slnx
/*.booproj
/*.pidb
/*.opendb
/*.VC.db
/*.VC.VC.opendb

# Keep shareable VS Code configuration; ignore local workspace files
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/launch.json
!/.vscode/tasks.json
!/.vscode/*.code-snippets

# Generated Rider editor integration
/[Aa]ssets/Plugins/Editor/JetBrains/
/[Aa]ssets/Plugins/Editor/JetBrains.meta

# Crash diagnostics
/sysinfo.txt
/mono_crash.*
/.dirstamp
/tmpinst-dir.stamp

# Temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
~$*

# Windows Explorer metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Metadata from collaborators using macOS
.DS_Store
._*

# Do NOT add broad rules for *.meta, *.png, *.ttf, *.wav, *.dll or *.exe.
# These can be required game assets or native camera/voice plugin files.
# Do NOT ignore Packages/manifest.json or Packages/packages-lock.json.

/TestResults
/Assets/StreamingAssets
